# Help tools that honor '.gitignore' (redundant for Git itself).
/.git

/CMakeUserPresets.json

# Common build directories
/build*/

# CI jobs that run in symlinked trees produce these artifacts.
/real_work/
/work

# MacOS Finder files.
.DS_Store

# Python compile output.
*.pyc

# See Utilities/Sphinx/tutorial_archive.cmake
/Help/_generated

# CLion work directory
/.idea/
# CLion build directories
/cmake-build-*/

# QtCreator files.
/CMakeLists.txt.user*

# Visual Studio Code
/.vscode/
/.cache/

# Visual Studio work directory
/.vs/
# Visual Studio build directory
/out/

# clang-tidy output
/clang-tidy-fixes.patch

Temporary/

.vscode/
.direnv/
crashes/
results*/
.claude/*
!.claude/skills/
.venv/

# FRET semantics reference paper (large binary / copyright)
semantics.pdf
semantics.txt

# Experiment outputs (generated at runtime). Ignored by content rather than by
# directory: git will not re-include a file whose parent directory is excluded,
# so `/experiments*/` would make the negations below dead letters. Descent stops
# at the campaign subdirectory — run dirs and CSVs are never walked.
/experiments*/*
!/experiments/README.md
!/experiments/*/
/experiments/*/*
!/experiments/*/PROVENANCE.json
# A campaign's pre-registered plan, where one was written before it launched.
# Worth tracking only because the decision rule has to be checkable against the
# result it was meant to bind; the root PLAN.md is ignored for the opposite
# reason, being a working file with no such claim on it.
!/experiments/*/PLAN.md
# Retrofitted copies of the drivers each campaign ran, recovered from history.
# Same problem one level down: re-open descent into scripts/ before negating,
# then re-exclude its contents so only the .py files come back.
!/experiments/*/scripts/
/experiments/*/scripts/*
!/experiments/*/scripts/*.py
# scripts/merge_experiments.py scratch dir + per-run results (also covered by
# /experiments/, but kept explicit so they stay ignored if that's relaxed).
.merge_tmp/
results/

# Experiment planning (not committed). Anchored: unanchored, it matches at every
# depth and silently outranks the campaign-plan negation above, which is later in
# the file only by accident of grouping.
/PLAN.md
