# Generated by cmake/install.cmake. Source this to point an installed counter
# at the solvers installed beside it:
#
#     . <prefix>/@COUNTER_DATA_DIR@/counter-env.sh
#
# Every path counter spawns is compiled in as an absolute path into the build
# tree it was built from, and these variables override that. Without them an
# installed binary still reaches for a build directory that may not exist.
# Resolved from this file's own location, so the tree stays relocatable.
_counter_prefix=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]:-$0}")/../.." && pwd)

COUNTER_SPOT_BIN_DIR="$_counter_prefix/@COUNTER_TOOL_DIR@/spot/bin"
COUNTER_GANAK_PATH="$_counter_prefix/@COUNTER_TOOL_DIR@/ganak"
COUNTER_BLACK_PATH="$_counter_prefix/@COUNTER_TOOL_DIR@/black/bin/black"
COUNTER_FORMALISER_SCRIPT="$_counter_prefix/@COUNTER_DATA_DIR@/fretCLI.main.js"
COUNTER_DASHBOARD_PAGE="$_counter_prefix/@COUNTER_DATA_DIR@/dashboard.html"

export COUNTER_SPOT_BIN_DIR COUNTER_GANAK_PATH COUNTER_BLACK_PATH
export COUNTER_FORMALISER_SCRIPT COUNTER_DASHBOARD_PAGE
unset _counter_prefix
