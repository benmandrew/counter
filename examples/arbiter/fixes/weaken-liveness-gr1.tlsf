INFO {
  TITLE:       "GR(1) arbiter (repaired, conditional liveness)";
  DESCRIPTION: "Two-client mutual-exclusion arbiter; grant-liveness made conditional on request-liveness (GR(1) form), no environment assumptions";
  SEMANTICS:   Mealy;
  TARGET:      Mealy;
}

MAIN {
  INPUTS {
    r0;
    r1;
  }
  OUTPUTS {
    g0;
    g1;
  }
  GUARANTEE {
    G (g0 -> r0);
    G (g1 -> r1);
    G !(g0 & g1);
    (G F r0 -> G F g0);
    (G F r1 -> G F g1);
  }
}
