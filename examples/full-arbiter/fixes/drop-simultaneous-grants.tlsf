INFO {
  TITLE:       "Full Arbiter (repaired, no simultaneous grants)"
  DESCRIPTION: "Simultaneous-grant asserts removed; no-spurious-grant asserts, mutex, and response guarantees retained"
  SEMANTICS:   Mealy
  TARGET:      Mealy
}

MAIN {
  INPUTS {
    r_0;
    r_1;
    r_2;
  }
  OUTPUTS {
    g_0;
    g_1;
    g_2;
  }
  ASSERT {
    (((g_0) && (G (! (r_0)))) -> (F (! (g_0))));
    (((g_0) && (X ((! (r_0)) && (! (g_0))))) -> (X ((r_0) R (! (g_0)))));
    (((g_1) && (G (! (r_1)))) -> (F (! (g_1))));
    (((g_1) && (X ((! (r_1)) && (! (g_1))))) -> (X ((r_1) R (! (g_1)))));
    (((g_2) && (G (! (r_2)))) -> (F (! (g_2))));
    (((g_2) && (X ((! (r_2)) && (! (g_2))))) -> (X ((r_2) R (! (g_2)))));
    (((! (g_0)) && (! (g_1))) || (((! (g_0)) || (! (g_1))) && (! (g_2))));
  }
  GUARANTEE {
    ((r_0) R (! (g_0)));
    (G ((r_0) -> (F (g_0))));
    ((r_1) R (! (g_1)));
    (G ((r_1) -> (F (g_1))));
    ((r_2) R (! (g_2)));
    (G ((r_2) -> (F (g_2))));
  }
}
