// Hand-written weakening ideal: a default-on grant may also be dropped when
// another channel takes the bus, not only when its own request arrives.
//
// The three-channel version of lily15. `mucs` returns
// { r1 -> F a1, !(a0 && a1), a0 W r0 }, and the two index permutations of it
// are cores as well. `a0 W r0`, `a1 W r1` and `a2 W r2` each hold their
// acknowledgement high by default until the matching request arrives, so at
// time zero -- before any request -- all three are demanded at once, which the
// three pairwise exclusions forbid. The same trap persists later: a channel
// whose request never comes parks its acknowledgement forever and starves the
// other two.
//
// W is monotone in its second argument, so widening the release condition to
// "my request, or somebody else has the bus" is implied by the original. It is
// the handoff the arbiter already performs, and it leaves the response
// liveness and all three exclusions untouched.
INFO {
  TITLE:       "Lily Demo V16"
  DESCRIPTION: "weakened: a default grant is released by a handoff too"
  SEMANTICS:   Mealy
  TARGET:      Mealy
}

MAIN {

  INPUTS {
    r0;
    r1;
    r2;
  }

  OUTPUTS {
    a0;
    a1;
    a2;
  }

  INVARIANTS {
    r0 -> F a0;
    r1 -> F a1;
    r2 -> F a2;
    !(a0 && a1);
    !(a0 && a2);
    !(a1 && a2);
  }

  GUARANTEES {
    a0 W (r0 || a1 || a2);
    a1 W (r1 || a0 || a2);
    a2 W (r2 || a0 || a1);
  }

}
