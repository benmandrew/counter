// Ported from AuRUS's reference repair, case-studies/syntcomp-unreal/
// load_balancer/genuine/load_balancer_2.tlsf, lowered with `syfco -f basic`.
//
// It drops the injected guarantee demanding that two requests arriving on
// consecutive steps be answered by two grants raised on the same step, which
// the at-most-one-grant ASSERT forbids outright.
INFO {
  TITLE:       "Parameterized Load Balancer"
  DESCRIPTION: "Parameterized Load Balancer (generalized version of the Acacia+ benchmark)"
  SEMANTICS:   Mealy
  TARGET:      Mealy
}

MAIN {
  INPUTS {
    idle;
    request_0;
    request_1;
  }
  OUTPUTS {
    grant_0;
    grant_1;
  }
  ASSUME {
    (G (F (idle)));
    (G (((idle) && (X ((! (grant_0)) && (! (grant_1))))) -> (X (idle))));
    (G ((X (! (grant_0))) || (X (((! (request_0)) && (! (idle))) U ((! (request_0)) && (idle))))));
  }
  ASSERT {
    (X (((! (grant_0)) && (true)) || ((true) && (! (grant_1)))));
    ((X (grant_0)) -> (request_0));
    ((X (grant_1)) -> (request_1));
    ((request_0) -> (grant_1));
    ((! (idle)) -> (X ((! (grant_0)) && (! (grant_1)))));
  }
  GUARANTEE {
    (! (F (G ((request_0) && (X (! (grant_0)))))));
    (! (F (G ((request_1) && (X (! (grant_1)))))));
  }
}
