INFO {
  TITLE:       "Parameterized Load Balancer (repaired)"
  DESCRIPTION: "Removes the cross-forcing request_0 -> grant_1 assert and the simultaneous-grant assert, resolving both safety contradictions against the mutex; response/liveness guarantees and the G F idle assumption retained"
  SEMANTICS:   Mealy
  TARGET:      Mealy
}

MAIN {
  INPUTS {
    idle;
    request_0;
    request_1;
  }
  OUTPUTS {
    grant_0;
    grant_1;
  }
  ASSUME {
    (G (F (idle)));
    (G (((idle) && (X ((! (grant_0)) && (! (grant_1))))) -> (X (idle))));
    (G ((X (! (grant_0))) || (X (((! (request_0)) && (! (idle))) U ((! (request_0)) && (idle))))));
  }
  ASSERT {
    (X ((! (grant_0)) || (! (grant_1))));
    ((X (grant_0)) -> (request_0));
    ((X (grant_1)) -> (request_1));
    ((! (idle)) -> (X ((! (grant_0)) && (! (grant_1)))));
  }
  GUARANTEE {
    (! (F (G ((request_0) && (X (! (grant_0)))))));
    (! (F (G ((request_1) && (X (! (grant_1)))))));
  }
}
