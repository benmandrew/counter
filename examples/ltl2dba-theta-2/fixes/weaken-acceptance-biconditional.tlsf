// Hand-written weakening ideal. AuRUS ships no reference repair for this
// benchmark (there is no genuine/ directory beside
// case-studies/syntcomp-unreal/ltl2dba_theta_2/).
//
// The single guarantee is a biconditional between an input property and an
// output one, so the system must decide, at every point at which it chooses
// `acc`, whether `G F p_0 && G F p_1 && !(G (q -> F r))` will hold of the whole
// infinite future of the four inputs. Emitting `acc` forever loses whenever the
// environment answers every `q` with an `r`; withholding it forever loses
// whenever the environment pulses both `p` signals forever and leaves one `q`
// unanswered.
//
// Dropping the right-to-left direction keeps the liveness intent — an input
// stream that satisfies the trigger is still acknowledged infinitely often —
// and discards only the obligation to withhold `acc` on the strength of an
// unobservable future.
INFO {
  TITLE:       "LTL -> DBA  -  Formula Theta From LtlNfBa Paper"
  DESCRIPTION: "Conversion of LTL to Deterministic Buchi Automaton"
  SEMANTICS:   Mealy
  TARGET:      Mealy
}

MAIN {
  INPUTS {
    r;
    q;
    p_0;
    p_1;
  }
  OUTPUTS {
    acc;
  }
  GUARANTEE {
    ((! (((G (F (p_0))) && (G (F (p_1)))) -> (G ((q) -> (F (r)))))) -> (G (F (acc))));
  }
}
