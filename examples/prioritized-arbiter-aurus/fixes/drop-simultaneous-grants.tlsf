// Ported from AuRUS's reference repair, case-studies/syntcomp-unreal/
// prioritized_arbiter/genuine/prioritized_arbiter_3.tlsf, lowered with `syfco -f basic`.
//
// It drops the injected guarantee demanding that two requests arriving on
// consecutive steps be answered by two grants raised on the same step, which
// the at-most-one-grant ASSERT forbids outright.
INFO {
  TITLE:       "Prioritized Arbiter"
  DESCRIPTION: "Parameterized Arbiter with a unique master process which has priority angainst others"
  SEMANTICS:   Mealy
  TARGET:      Mealy
}

MAIN {
  INPUTS {
    r_m;
    r_0;
    r_1;
    r_2;
  }
  OUTPUTS {
    g_m;
    g_0;
    g_1;
    g_2;
  }
  ASSUME {
    (G (F (! (r_m))));
  }
  ASSERT {
    ((((! (g_0)) && (! (g_1))) && (true)) || ((((! (g_0)) && (true)) || ((true) && (! (g_1)))) && (! (g_2))));
    (! ((g_m) && (g_0)));
    (! ((g_m) && (g_1)));
    (! ((g_m) && (g_2)));
  }
  GUARANTEE {
    (G ((r_0) -> (F (g_0))));
    (G ((r_1) -> (F (g_1))));
    (G ((r_2) -> (F (g_2))));
    (G ((r_m) -> (X ((((! (g_0)) && (! (g_1))) && (! (g_2))) U (g_m)))));
  }
}
